<Window x:Class="GpoMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GpoMacro"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="GPO Fishing Macro"
        Height="740" Width="1020" MinHeight="640" MinWidth="900"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- One row of the settings form. A checkbox spans the row; everything
             else is label plus field. -->
        <DataTemplate x:Key="BoolField">
            <CheckBox Style="{StaticResource Check}" Content="{Binding Label}"
                      IsChecked="{Binding Flag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,3"
                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}" />
        </DataTemplate>

        <!-- Label, field, then what the knob does. The third column is where
             the webhook reports its last delivery. -->
        <DataTemplate x:Key="TextField">
            <Grid Margin="0,3" MinHeight="28"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}"
                           TextWrapping="Wrap" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Style="{StaticResource Field}"
                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Effect}"
                           Text="{Binding Effect}" Foreground="{Binding EffectBrush}" />
            </Grid>
        </DataTemplate>

        <!-- The webhook URL is a credential: masked in the field, and never
             echoed anywhere else in the app. -->
        <DataTemplate x:Key="SecretField">
            <Grid Margin="0,3" MinHeight="28"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}"
                           TextWrapping="Wrap" Margin="0,0,10,0" />
                <PasswordBox Grid.Column="1" Style="{StaticResource SecretField}"
                             Loaded="Secret_Loaded" PasswordChanged="Secret_Changed" />
                <TextBlock Grid.Column="2" Style="{StaticResource Effect}"
                           Text="{Binding Effect}" Foreground="{Binding EffectBrush}" />
            </Grid>
        </DataTemplate>

        <local:FieldTemplateSelector x:Key="FieldSelector"
                                     BoolTemplate="{StaticResource BoolField}"
                                     TextTemplate="{StaticResource TextField}"
                                     SecretTemplate="{StaticResource SecretField}" />
    </Window.Resources>

    <TabControl Style="{StaticResource SidebarTabControl}"
                ItemContainerStyle="{StaticResource NavItem}"
                SelectedIndex="{Binding SelectedScreen, Mode=TwoWay}">

        <!-- ============================================ DASHBOARD ========= -->
        <TabItem Header="Dashboard" Tag="{Binding DashboardDot}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Status strip: the state word, the window it is driving, a
                     sentence saying what happens next, and the controls. -->
                <Border Style="{StaticResource Panel}">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.RowSpan="2" VerticalAlignment="Center"
                                   Margin="0,0,24,0"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="{StaticResource SizeHero}" FontWeight="Bold"
                                   Text="{Binding StateWord}" Foreground="{Binding StateBrush}" />

                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="{StaticResource SizeMeta}"
                                   Foreground="{StaticResource Faint}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding WindowLine}" />
                        <TextBlock Grid.Column="1" Grid.Row="1" VerticalAlignment="Top"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Sans}"
                                   FontSize="{StaticResource SizeLabel}"
                                   Text="{Binding Hint}" Foreground="{Binding HintBrush}" />

                        <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="18,0,0,0">
                            <Button x:Name="StartButton" Style="{StaticResource AccentButton}"
                                    Content="{Binding StartLabel}"
                                    Background="{Binding StartBrush}"
                                    BorderBrush="{Binding StartBrush}"
                                    MinWidth="96" Click="Start_Click" />
                            <Button Style="{StaticResource QuietButton}" Content="Pause"
                                    MinWidth="80" Margin="6,0" Click="Pause_Click"
                                    IsEnabled="{Binding CanPause}" />
                            <Button Style="{StaticResource DangerButton}" Content="Panic"
                                    MinWidth="80" Click="Panic_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Counters. Mono, because every one of them is a number. -->
                <primitives:UniformGrid Grid.Row="1" Rows="1" Margin="0,6,0,0">
                    <Border Style="{StaticResource Panel}" Margin="0,0,3,0">
                        <StackPanel Margin="12,8" HorizontalAlignment="Center">
                            <TextBlock Text="CAUGHT" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeMeta}"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Text="{Binding Caught}" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                       FontSize="{StaticResource SizeCounter}"
                                       Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="3,0">
                        <StackPanel Margin="12,8" HorizontalAlignment="Center">
                            <TextBlock Text="PER HOUR" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeMeta}"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Text="{Binding PerHour}" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                       FontSize="{StaticResource SizeCounter}"
                                       Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="3,0">
                        <StackPanel Margin="12,8" HorizontalAlignment="Center">
                            <TextBlock Text="HOOK RATE" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeMeta}"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Text="{Binding HookRate}" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                       FontSize="{StaticResource SizeCounter}"
                                       Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="3,0">
                        <StackPanel Margin="12,8" HorizontalAlignment="Center">
                            <TextBlock Text="ESCAPED" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeMeta}"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Text="{Binding Escaped}" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                       FontSize="{StaticResource SizeCounter}"
                                       Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="3,0">
                        <StackPanel Margin="12,8" HorizontalAlignment="Center">
                            <TextBlock Text="TIMEOUTS" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeMeta}"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Text="{Binding Timeouts}" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                       FontSize="{StaticResource SizeCounter}"
                                       Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="3,0,0,0">
                        <StackPanel Margin="12,8" HorizontalAlignment="Center">
                            <TextBlock Text="SESSION" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeMeta}"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Text="{Binding Session}" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                       FontSize="{StaticResource SizeCounter}"
                                       Foreground="{StaticResource Text}" />
                        </StackPanel>
                    </Border>
                </primitives:UniformGrid>

                <!-- Reel readout: the tuning surface. Everything needed to set
                     bar_lead is here, so tuning never means reading the log. -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,6,0,0">
                    <DockPanel Margin="12,10">
                        <!-- What the macro sees: the engine's own capture of the
                             gauge, beside the readings it took from it. Between
                             fights the well stays, hatched, rather than
                             collapsing the panel. -->
                        <Border DockPanel.Dock="Right" Style="{StaticResource CaptureWell}"
                                Width="108" Height="148" Margin="16,0,0,0"
                                Tag="{Binding Preview}">
                            <Grid>
                                <TextBlock Text="no fight" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Mono}"
                                           FontSize="{StaticResource SizeMeta}"
                                           Foreground="{StaticResource Faint}" />
                                <Image Source="{Binding Preview}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Grid>
                        </Border>

                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewNote}"
                                           FontFamily="{StaticResource Mono}"
                                           FontSize="{StaticResource SizeMeta}"
                                           Foreground="{StaticResource Faint}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="REEL" FontFamily="{StaticResource Mono}"
                                           FontWeight="Bold" FontSize="{StaticResource SizeLabel}"
                                           Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HoldWord}" Width="52" Margin="12,0,0,0"
                                           FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                           FontSize="{StaticResource SizeLabel}"
                                           Foreground="{Binding HoldBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OnFishLine}" Margin="6,0,0,0"
                                           FontFamily="{StaticResource Mono}"
                                           FontSize="{StaticResource SizeLabel}"
                                           Foreground="{Binding OnFishBrush}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <ProgressBar Style="{StaticResource Meter}" Margin="0,8,0,4"
                                         Value="{Binding Meter}" Foreground="{Binding MeterBrush}" />

                            <TextBlock Text="{Binding TelemetryLine}"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeReadout}"
                                       Foreground="{Binding TelemetryBrush}" />

                            <!-- Reading "error -4" and knowing to raise Bar lead
                                 is knowledge the app should not assume. -->
                            <TextBlock Text="{Binding TuningNote}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       FontFamily="{StaticResource Sans}"
                                       FontSize="{StaticResource SizeLabel}"
                                       Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,6,0,0">
                    <DockPanel Margin="12,10">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LogCountLine}"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeMeta}"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Text="EVENT LOG" Style="{StaticResource Heading}" Margin="0" />
                        </DockPanel>
                        <!-- The log is capped at 300 lines, so virtualizing it buys
                             nothing and its generator is where the
                             inconsistency crash came from. -->
                        <ListBox x:Name="LogList" Style="{StaticResource LogList}"
                                 ItemsSource="{Binding Log}" MinHeight="120"
                                 VirtualizingPanel.IsVirtualizing="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" Width="62"
                                                   FontFamily="{StaticResource Mono}"
                                                   FontSize="{StaticResource SizeBody}"
                                                   Foreground="{StaticResource Faint}" />
                                        <TextBlock Text="{Binding Mark}" Width="16"
                                                   FontFamily="{StaticResource Mono}"
                                                   FontSize="{StaticResource SizeBody}"
                                                   Foreground="{Binding Brush}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource Mono}"
                                                   FontSize="{StaticResource SizeBody}"
                                                   Foreground="{Binding Brush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ========================================== CALIBRATION ========= -->
        <TabItem Header="Calibration" Tag="{Binding CalibrationDot}">
            <DockPanel>
                <!-- The proof rail: what the macro sees, beside the cards
                     that set it. A sibling column, never scrolls. -->
                <Border DockPanel.Dock="Right" Width="300" Background="{StaticResource Bg}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <DockPanel Margin="14,14,14,12">
                        <TextBlock DockPanel.Dock="Top" Text="WHAT THE MACRO SEES"
                                   Style="{StaticResource Heading}" Margin="0,0,0,9" />
                        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}">
                            <ItemsControl ItemsSource="{Binding Rail}" Margin="12,9">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" Margin="0,2"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource Mono}"
                                                   FontSize="{StaticResource SizeLabel}"
                                                   Foreground="{Binding Brush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- The tail of the log, 11px, so a test's verdict lands
                             beside its capture. -->
                        <ListBox x:Name="RailLogList" DockPanel.Dock="Bottom"
                                 Style="{StaticResource LogList}" Height="96"
                                 ItemsSource="{Binding Log}"
                                 VirtualizingPanel.IsVirtualizing="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" Width="58"
                                                   FontFamily="{StaticResource Mono}"
                                                   FontSize="{StaticResource SizeLabel}"
                                                   Foreground="{StaticResource Faint}" />
                                        <TextBlock Text="{Binding Mark}" Width="14"
                                                   FontFamily="{StaticResource Mono}"
                                                   FontSize="{StaticResource SizeLabel}"
                                                   Foreground="{Binding Brush}" />
                                        <TextBlock Text="{Binding Message}" Width="176"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="{StaticResource Mono}"
                                                   FontSize="{StaticResource SizeLabel}"
                                                   Foreground="{Binding Brush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- The last test capture, boxed by the engine itself. -->
                        <Border Style="{StaticResource CaptureWell}" Width="140" Height="262"
                                BorderBrush="{StaticResource LineStrong}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Tag="{Binding TestCapture}">
                            <Grid>
                                <TextBlock Text="no test yet" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Mono}"
                                           FontSize="{StaticResource SizeMeta}"
                                           Foreground="{StaticResource Faint}" />
                                <Image Source="{Binding TestCapture}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="5" Padding="3,1" CornerRadius="2"
                                        Background="{StaticResource Bg}" Opacity="0.85">
                                    <TextBlock Text="{Binding TestCaptureTag}"
                                               FontFamily="{StaticResource Mono}" FontSize="9"
                                               Foreground="{StaticResource Green}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <DockPanel Margin="14">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="CALIBRATION" FontFamily="{StaticResource Mono}"
                                   FontWeight="Bold" FontSize="{StaticResource SizeHead}"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                   Text="{Binding CalibrationSummary}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="0,10,0,0"
                               Text="Every point and region is stored relative to the Roblox window, so moving the window does not mean redoing any of this." />

                    <!-- The cards scroll on their own: three open at once
                         overflow the window otherwise. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Calibration}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Panel}" Margin="0,0,0,6"
                                            BorderBrush="{Binding EdgeBrush}">
                                        <StackPanel>
                                            <Button Style="{StaticResource CardHeader}"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    Click="CalToggle_Click">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Mark}"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Mono}"
                                                               FontSize="{StaticResource SizeMeta}"
                                                               Foreground="{Binding MarkBrush}" />
                                                    <TextBlock Text="{Binding Chevron}" Width="9"
                                                               Margin="0,0,10,0" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Mono}"
                                                               FontSize="{StaticResource SizeMeta}"
                                                               Foreground="{StaticResource Faint}" />
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                                               FontSize="{StaticResource SizeLabel}"
                                                               Foreground="{Binding TitleBrush}" />
                                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left"
                                                            Visibility="{Binding IsOptional,
                                                                Converter={StaticResource BoolToVisible}}">
                                                        <TextBlock Text="optional"
                                                                   FontFamily="{StaticResource Mono}"
                                                                   FontSize="{StaticResource SizeMeta}"
                                                                   Foreground="{StaticResource Faint}" />
                                                    </Border>
                                                </DockPanel>
                                            </Button>

                                            <StackPanel Margin="12,0,12,12"
                                                        Visibility="{Binding IsOpen,
                                                            Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Style="{StaticResource Note}" MaxWidth="640"
                                                           Text="{Binding Note}" Margin="0,0,0,10" />

                                                <!-- Why it failed, in words, above the
                                                     thing that fixes it. -->
                                                <Border Background="{StaticResource Surface2}"
                                                        CornerRadius="3" Padding="11,9" Margin="0,0,0,10"
                                                        BorderBrush="{Binding FaultBrush}"
                                                        BorderThickness="2,0,0,0"
                                                        Visibility="{Binding HasFault,
                                                            Converter={StaticResource BoolToVisible}}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding FaultWord}"
                                                                   Margin="0,1,9,0" VerticalAlignment="Top"
                                                                   FontFamily="{StaticResource Mono}" FontWeight="Bold"
                                                                   FontSize="{StaticResource SizeLabel}"
                                                                   Foreground="{Binding FaultBrush}" />
                                                        <TextBlock Text="{Binding FaultText}" TextWrapping="Wrap"
                                                                   FontFamily="{StaticResource Sans}"
                                                                   FontSize="{StaticResource SizeBody}"
                                                                   Foreground="{StaticResource Text2}" />
                                                    </DockPanel>
                                                </Border>

                                                <DockPanel Margin="0,0,0,10">
                                                    <Border DockPanel.Dock="Left" Width="76" Height="76"
                                                            Margin="0,0,12,0" VerticalAlignment="Top"
                                                            CornerRadius="4" BorderThickness="1"
                                                            Background="{Binding Thumb}"
                                                            BorderBrush="{Binding ThumbEdge}"
                                                            Visibility="{Binding HasThumb,
                                                                Converter={StaticResource BoolToVisible}}">
                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                Margin="3" Padding="3,1" CornerRadius="2"
                                                                Background="{StaticResource Bg}" Opacity="0.85">
                                                            <TextBlock Text="{Binding ThumbTag}"
                                                                       FontFamily="{StaticResource Mono}" FontSize="9"
                                                                       Foreground="{StaticResource Text2}" />
                                                        </Border>
                                                    </Border>
                                                    <Border Background="{StaticResource Surface2}"
                                                            CornerRadius="4" Padding="10,8">
                                                        <TextBlock Text="{Binding Readout}" LineHeight="21"
                                                                   FontFamily="{StaticResource Mono}"
                                                                   FontSize="{StaticResource SizeBody}"
                                                                   Foreground="{Binding ReadoutBrush}" />
                                                    </Border>
                                                </DockPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource PrimaryQuietButton}"
                                                            Content="{Binding Primary.Label}"
                                                            Tag="{Binding Primary.Tag}" Click="CalAction_Click" />
                                                    <Button Style="{StaticResource TextAction}"
                                                            Content="{Binding MoreLabel}" Margin="6,0,0,0"
                                                            Click="CalMore_Click" />
                                                </StackPanel>

                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                                                        Margin="0,10,0,0" Padding="0,10,0,0"
                                                        Visibility="{Binding IsMoreOpen,
                                                            Converter={StaticResource BoolToVisible}}">
                                                    <ItemsControl ItemsSource="{Binding Extras}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource ChipButton}"
                                                                        Content="{Binding Label}"
                                                                        Tag="{Binding Tag}"
                                                                        Click="CalAction_Click" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </TabItem>

        <!-- ============================================= SETTINGS ========= -->
        <TabItem Header="Settings" Tag="{Binding SettingsDot}">
            <DockPanel>
                <!-- Header: what this is, a filter, and the advanced fold. -->
                <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Check}"
                              Content="Show advanced" VerticalAlignment="Center"
                              FontSize="{StaticResource SizeLabel}"
                              IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" />
                    <Border DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                            Background="{StaticResource Surface2}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="4" MinWidth="190">
                        <DockPanel Margin="10,0,0,0">
                            <TextBlock Text="filter" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeLabel}"
                                       Foreground="{StaticResource Faint}" />
                            <TextBox Style="{StaticResource Field}" BorderThickness="0"
                                     Background="Transparent" MinWidth="120"
                                     Text="{Binding FilterText, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SETTINGS" FontFamily="{StaticResource Mono}"
                                   FontWeight="Bold" FontSize="{StaticResource SizeHead}"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                                   Text="Generated from the engine's schema. Nothing saves as you type." />
                    </StackPanel>
                </DockPanel>

                <!-- The save bar. Sticky, on the ground, above a hairline.
                     Updates live here too: one line and a button, not a
                     setting. -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg}"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <StackPanel Margin="16,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}"
                                    Content="Save settings"
                                    Background="{Binding SaveBrush}" BorderBrush="{Binding SaveBrush}"
                                    MinWidth="140" Click="Save_Click" />
                            <Button DockPanel.Dock="Left" Style="{StaticResource QuietButton}"
                                    Content="Reset session stats"
                                    MinWidth="170" Margin="6,0,0,0" Click="ResetStats_Click" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding DirtyLine}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource Sans}"
                                       FontSize="{StaticResource SizeLabel}"
                                       Foreground="{StaticResource Amber}" />

                            <!-- One update button: check, or install once there
                                 is something to install. -->
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                    Content="{Binding UpdateButtonText}" MinWidth="150"
                                    IsEnabled="{Binding CanCheckUpdates}"
                                    Click="InstallUpdate_Click"
                                    Visibility="{Binding UpdateAvailable,
                                        Converter={StaticResource BoolToVisible}}" />
                            <Button DockPanel.Dock="Right" Content="Check for updates" MinWidth="130"
                                    IsEnabled="{Binding CanCheckUpdates}" Click="CheckUpdates_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Fills what is left, so it trims before a button does. -->
                            <TextBlock VerticalAlignment="Center" Margin="12,0,12,0"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource Mono}"
                                       FontSize="{StaticResource SizeLabel}">
                                <Run Text="{Binding VersionLine, Mode=OneWay}"
                                     Foreground="{StaticResource Faint}" />
                                <Run Text="{Binding UpdateStatus, Mode=OneWay}"
                                     Foreground="{Binding UpdateBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Meter}" Margin="0,10,0,0"
                                     Value="{Binding UpdateProgress}"
                                     Foreground="{StaticResource Green}"
                                     Visibility="{Binding UpdateProgressVisible,
                                         Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,6,0">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="0,0,10,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Visibility="{Binding IsVisible,
                                                Converter={StaticResource BoolToVisible}}">
                                    <!-- Headings and notes sit on the page,
                                         above the panel, never inside it. -->
                                    <DockPanel Margin="0,12,0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource TextAction}"
                                                Content="reset section" Click="ResetSection_Click" />
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource Heading}" Margin="0"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left"
                                                Visibility="{Binding IsAdvanced,
                                                    Converter={StaticResource BoolToVisible}}">
                                            <TextBlock Text="advanced"
                                                       FontFamily="{StaticResource Mono}"
                                                       FontSize="{StaticResource SizeMeta}"
                                                       Foreground="{StaticResource Amber}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Note}"
                                               MaxWidth="700"
                                               Visibility="{Binding HasNote,
                                                   Converter={StaticResource BoolToVisible}}" />
                                    <Border Style="{StaticResource Panel}">
                                        <StackPanel Margin="12,8">
                                            <ItemsControl ItemsSource="{Binding Fields}"
                                                          ItemTemplateSelector="{StaticResource FieldSelector}" />
                                            <!-- A webhook you cannot verify is a
                                                 webhook you do not trust. The
                                                 result lands beside the URL. -->
                                            <Button Style="{StaticResource QuietButton}"
                                                    Content="Send test message" MinWidth="170"
                                                    Margin="0,8,0,0" HorizontalAlignment="Left"
                                                    Click="WebhookTest_Click"
                                                    Visibility="{Binding IsWebhook,
                                                        Converter={StaticResource BoolToVisible}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
